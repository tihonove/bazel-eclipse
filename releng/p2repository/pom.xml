<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!--
    Fork: explicit pom (was pomless) to patch the assembled repository.
    Velocity 2.4.1 imports org.slf4j [1.7,2) but everything around it ships
    slf4j 2.x, so its manifest is widened after assembly, checksums are fixed
    and only then the repository is archived.
  -->

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.salesforce.bazel.eclipse.feature.releng</groupId>
    <artifactId>bazel-eclipse-plugins</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>p2repository.eclipse-repository</artifactId>
  <packaging>eclipse-repository</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>patch-velocity-manifest</id>
            <phase>package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${project.basedir}/patch-velocity-manifest.py</argument>
                <argument>${project.build.directory}/repository</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-repository-plugin</artifactId>
        <executions>
          <execution>
            <!-- moved after the patch below -->
            <id>default-archive-repository</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>fix-velocity-artifact-metadata</id>
            <phase>package</phase>
            <goals>
              <goal>fix-artifacts-metadata</goal>
            </goals>
          </execution>
          <execution>
            <id>archive-patched-repository</id>
            <phase>package</phase>
            <goals>
              <goal>archive-repository</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
